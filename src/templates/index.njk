    <section class="cta-section py-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto text-center text-white">
                    <h2 class="display-5 fw-bold mb-3" data-aos="zoom-in">Ready to Get Started?</h2>
                    <p class="lead mb-4" data-aos="zoom-in" data-aos-delay="100">
                        Join thousands of businesses that trust TechFlow for their digital transformation.
                    </p>
                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center" data-aos="zoom-in" data-aos-delay="200">
                        <a href="contact.html" class="btn btn-light btn-lg px-5">
                            <i class="bi bi-telephone me-2"></i>Contact Sales
