{% extends "base.njk" %}

{% block content %}
    <section class="hero-section min-vh-100 d-flex align-items-center">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6" data-aos="fade-right">
                    <h1 class="display-4 fw-bold mb-4 text-white">
                        Transform Your Business with 
                        <span class="text-dark">Modern Technology</span>
                    </h1>
                    <p class="lead mb-4 text-light opacity-75">
                        We deliver cutting-edge solutions that help your business grow, scale, and succeed in the digital age. Join thousands of satisfied clients worldwide.
                    </p>
                    
                    <div class="row mb-4">
                        <div class="col-4 text-center">
                            <h3 class="fw-bold mb-1 counter text-white" data-target="250">0</h3>
                            <small class="text-light opacity-75">Projects</small>
                        </div>
                        <div class="col-4 text-center">
                            <h3 class="fw-bold mb-1 counter text-white" data-target="98">0</h3>
                            <small class="text-light opacity-75">% Success</small>
                        </div>
                        <div class="col-4 text-center">
                            <h3 class="fw-bold mb-1 text-white">24/7</h3>
                            <small class="text-light opacity-75">Support</small>
                        </div>
                    </div>
                    
                    <div class="d-flex flex-column flex-sm-row gap-3">
                        <button class="btn btn-light btn-lg px-4" data-bs-toggle="modal" data-bs-target="#demoModal">
                            <i class="bi bi-play-circle me-2"></i>Watch Demo
                        </button>
                        <button class="btn btn-outline-light btn-lg px-4" onclick="scrollToSection('features')">
                            <i class="bi bi-arrow-down me-2"></i>Learn More
                        </button>
                    </div>
                </div>
                <div class="col-lg-6" data-aos="fade-left">
                    <div class="position-relative">
                        <img src="https://images.unsplash.com/photo-1551434678-e076c223a692?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" 
                                class="img-fluid rounded-4 shadow-lg" alt="Technology">
                        <div class="floating-card position-absolute bottom-0 start-0 m-3">
                            <div class="card border-0 shadow">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-success rounded-circle p-2 me-3">
                                            <i class="bi bi-check-lg text-white"></i>
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold">Project Completed</h6>
                                            <small class="text-muted">2 minutes ago</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="features" class="py-5 bg-light">
        <div class="container">
            <div class="row text-center mb-5">
                <div class="col-lg-8 mx-auto">
                    <h2 class="display-5 fw-bold mb-3" data-aos="fade-up">Why Choose TechFlow?</h2>
                    <p class="lead text-muted" data-aos="fade-up" data-aos-delay="100">
                        Our comprehensive suite of services delivers results that matter
                    </p>
                </div>
            </div>
            
            <div class="row g-4">
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="feature-card card border-0 shadow-sm h-100">
                        <div class="card-body text-center p-4">
                            <div class="feature-icon bg-gradient-primary text-white rounded-circle mb-3 mx-auto">
                                <i class="bi bi-lightning-charge fs-2"></i>
                            </div>
                            <h4 class="fw-bold mb-3">Lightning Fast</h4>
                            <p class="text-muted mb-4">Optimized performance that delivers results in record time.</p>
                            <div class="progress mb-3" style="height: 8px;">
                                <div class="progress-bar bg-primary progress-animated" data-width="95">95%</div>
                            </div>
                            <small class="text-muted fw-semibold">Performance Score</small>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="300">
                    <div class="feature-card card border-0 shadow-sm h-100">
                        <div class="card-body text-center p-4">
                            <div class="feature-icon bg-gradient-success text-white rounded-circle mb-3 mx-auto">
                                <i class="bi bi-shield-check fs-2"></i>
                            </div>
                            <h4 class="fw-bold mb-3">Secure & Reliable</h4>
                            <p class="text-muted mb-4">Enterprise-grade security with 99.9% uptime guarantee.</p>
                            <div class="progress mb-3" style="height: 8px;">
                                <div class="progress-bar bg-success progress-animated" data-width="99">99%</div>
                            </div>
                            <small class="text-muted fw-semibold">Uptime Guarantee</small>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="400">
                    <div class="feature-card card border-0 shadow-sm h-100">
                        <div class="card-body text-center p-4">
                            <div class="feature-icon bg-gradient-primary text-white rounded-circle mb-3 mx-auto">
                                <i class="bi bi-headset fs-2"></i>
                            </div>
                            <h4 class="fw-bold mb-3">24/7 Support</h4>
                            <p class="text-muted mb-4">Round-the-clock expert support for your success.</p>
                            <div class="progress mb-3" style="height: 8px;">
                                <div class="progress-bar bg-info progress-animated" data-width="100">100%</div>
                            </div>
                            <small class="text-muted fw-semibold">Support Availability</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section id="services" class="py-5">
        <div class="container">
            <div class="row mb-5">
                <div class="col-lg-8 mx-auto text-center">
                    <h2 class="display-5 fw-bold mb-3" data-aos="fade-up">Our Services</h2>
                    <p class="lead text-muted" data-aos="fade-up" data-aos-delay="100">
                        Comprehensive solutions tailored to your business needs
                    </p>
                </div>
            </div>
            
            <div class="row g-4">
                <div class="col-lg-4" data-aos="flip-left" data-aos-delay="200">
