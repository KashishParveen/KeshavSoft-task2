                                <li class="d-flex align-items-center mb-2">
                                    <i class="bi bi-check-circle text-success me-2"></i>
                                    <small>Responsive Design</small>
                                </li>
                                <li class="d-flex align-items-center mb-2">
                                    <i class="bi bi-check-circle text-success me-2"></i>
                                    <small>SEO Optimized</small>
                                </li>
                                <li class="d-flex align-items-center">
                                    <i class="bi bi-check-circle text-success me-2"></i>
                                    <small>Fast Loading</small>
                                </li>
                            </ul>
                            
                            <button class="btn btn-outline-primary w-100" data-bs-toggle="modal" data-bs-target="#webDevModal">
                                <i class="bi bi-arrow-right me-2"></i>Learn More
                            </button>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4" data-aos="flip-left" data-aos-delay="300">
                    <div class="service-card card border-0 shadow-sm h-100">
                        <div class="card-header bg-success bg-opacity-10 border-0">
                            <div class="service-icon text-center">
                                <i class="bi bi-phone text-success display-4"></i>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <h4 class="card-title fw-bold text-center mb-3">Mobile Apps</h4>
                            <p class="card-text text-muted text-center mb-4">
                                Native and cross-platform mobile applications.
                            </p>
                            
                            <div class="skill-item mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="fw-semibold">iOS</small>
                                    <small>92%</small>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-success" data-width="92"></div>
                                </div>
                            </div>
                            
                            <div class="skill-item mb-4">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="fw-semibold">Android</small>
                                    <small>88%</small>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-success" data-width="88"></div>
                                </div>
                            </div>
                            
                            <ul class="list-unstyled mb-4">
                                <li class="d-flex align-items-center mb-2">
                                    <i class="bi bi-check-circle text-success me-2"></i>
                                    <small>iOS & Android</small>
                                </li>
                                <li class="d-flex align-items-center mb-2">
                                    <i class="bi bi-check-circle text-success me-2"></i>
                                    <small>Cross-platform</small>
                                </li>
                                <li class="d-flex align-items-center">
                                    <i class="bi bi-check-circle text-success me-2"></i>
                                    <small>User-friendly</small>
                                </li>
                            </ul>
                            
                            <button class="btn btn-outline-success w-100" data-bs-toggle="modal" data-bs-target="#mobileAppModal">
                                <i class="bi bi-arrow-right me-2"></i>Learn More
                            </button>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4" data-aos="flip-left" data-aos-delay="400">
                    <div class="service-card card border-0 shadow-sm h-100">
                        <div class="card-header bg-info bg-opacity-10 border-0">
                            <div class="service-icon text-center">
                                <i class="bi bi-cloud text-info display-4"></i>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <h4 class="card-title fw-bold text-center mb-3">Cloud Solutions</h4>
                            <p class="card-text text-muted text-center mb-4">
                                Scalable cloud infrastructure and migration services.
                            </p>
                            
                            <div class="skill-item mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="fw-semibold">AWS</small>
                                    <small>94%</small>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-info" data-width="94"></div>
                                </div>
                            </div>
                            
                            <div class="skill-item mb-4">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="fw-semibold">Azure</small>
                                    <small>89%</small>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-info" data-width="89"></div>
                                </div>
                            </div>
                            
                            <ul class="list-unstyled mb-4">
                                <li class="d-flex align-items-center mb-2">
                                    <i class="bi bi-check-circle text-success me-2"></i>
                                    <small>AWS & Azure</small>
                                </li>
                                <li class="d-flex align-items-center mb-2">
                                    <i class="bi bi-check-circle text-success me-2"></i>
                                    <small>Migration</small>
                                </li>
                                <li class="d-flex align-items-center">
                                    <i class="bi bi-check-circle text-success me-2"></i>
                                    <small>24/7 Monitoring</small>
                                </li>
                            </ul>
                            
                            <button class="btn btn-outline-info w-100" data-bs-toggle="modal" data-bs-target="#cloudModal">
                                <i class="bi bi-arrow-right me-2"></i>Learn More
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5 bg-light">
        <div class="container">
            <div class="row mb-5">
                <div class="col-lg-8 mx-auto text-center">
                    <h2 class="display-5 fw-bold mb-3" data-aos="fade-up">What Our Clients Say</h2>
                    <p class="lead text-muted">Trusted by businesses worldwide</p>
                </div>
            </div>
            
            <div id="testimonialCarousel" class="carousel slide" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    <button type="button" data-bs-target="#testimonialCarousel" data-bs-slide-to="0" class="active"></button>
                    <button type="button" data-bs-target="#testimonialCarousel" data-bs-slide-to="1"></button>
                    <button type="button" data-bs-target="#testimonialCarousel" data-bs-slide-to="2"></button>
                </div>
                
                <div class="carousel-inner">
                    <div class="carousel-item active">
