                            <div class="service-icon text-center">
                                <i class="bi bi-code-slash text-primary display-4"></i>
                            </div>
                        </div>
                        <div class="card-body p-4">
                            <h4 class="card-title fw-bold text-center mb-3">Web Development</h4>
                            <p class="card-text text-muted text-center mb-4">
                                Modern, responsive websites built with the latest technologies.
                            </p>
                            
                            <div class="skill-item mb-3">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="fw-semibold">Frontend</small>
                                    <small>95%</small>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-primary" data-width="95"></div>
                                </div>
                            </div>
                            
                            <div class="skill-item mb-4">
                                <div class="d-flex justify-content-between mb-1">
                                    <small class="fw-semibold">Backend</small>
                                    <small>90%</small>
                                </div>
                                <div class="progress" style="height: 6px;">
                                    <div class="progress-bar bg-primary" data-width="90"></div>
                                </div>
                            </div>
                            
