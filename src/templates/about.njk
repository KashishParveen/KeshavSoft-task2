{% extends "base.njk" %}

{% block content %}
    <section class="about-hero-section min-vh-50 d-flex align-items-center" style="background: var(--gradient-primary); padding-top: 100px;">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto text-center text-white">
                    <h1 class="display-4 fw-bold mb-3" data-aos="fade-up">About TechFlow</h1>
                    <p class="lead mb-4" data-aos="fade-up" data-aos-delay="100">
                        We're a team of passionate innovators dedicated to transforming businesses through technology.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="row align-items-center g-5">
                <div class="col-lg-6" data-aos="fade-right">
                    <h2 class="display-5 fw-bold mb-4">Our Story</h2>
                    <p class="lead text-muted mb-4">
                        Founded in 2015, TechFlow began with a simple mission: to help businesses leverage technology for growth and innovation.
                    </p>
                    <p class="mb-4">
                        What started as a small team of developers has grown into a full-service technology partner for businesses worldwide. 
                        We've helped over 250 clients transform their operations, reach new customers, and achieve their business goals.
                    </p>
                    <div class="d-flex flex-column flex-sm-row gap-3">
                        <a href="contact.html" class="btn btn-primary btn-lg px-4">
                            <i class="bi bi-telephone me-2"></i>Contact Us
                        </a>
                        <a href="index.html#services" class="btn btn-outline-primary btn-lg px-4">
                            <i class="bi bi-grid me-2"></i>Our Services
                        </a>
                    </div>
                </div>
                <div class="col-lg-6" data-aos="fade-left">
                    <img src="https://images.unsplash.com/photo-1522071820081-009f0129c71c?ixlib=rb-4.0.3&auto=format&fit=crop&w=600&q=80" 
                            class="img-fluid rounded-4 shadow-lg" alt="TechFlow Team">
                </div>
            </div>
        </div>
    </section>

    <section class="py-5 bg-light">
        <div class="container">
            <div class="row text-center mb-5">
                <div class="col-lg-8 mx-auto">
                    <h2 class="display-5 fw-bold mb-3" data-aos="fade-up">Our Values</h2>
                    <p class="lead text-muted" data-aos="fade-up" data-aos-delay="100">
                        The principles that guide everything we do
                    </p>
                </div>
            </div>
            
            <div class="row g-4">
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="feature-card card border-0 shadow-sm h-100">
                        <div class="card-body text-center p-4">
                            <div class="feature-icon bg-gradient-primary text-white rounded-circle mb-3 mx-auto">
                                <i class="bi bi-lightbulb fs-2"></i>
                            </div>
                            <h4 class="fw-bold mb-3">Innovation</h4>
                            <p class="text-muted">We constantly explore new technologies and approaches to deliver cutting-edge solutions.</p>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="300">
                    <div class="feature-card card border-0 shadow-sm h-100">
                        <div class="card-body text-center p-4">
                            <div class="feature-icon bg-gradient-success text-white rounded-circle mb-3 mx-auto">
                                <i class="bi bi-people fs-2"></i>
                            </div>
                            <h4 class="fw-bold mb-3">Collaboration</h4>
                            <p class="text-muted">We work closely with our clients to understand their needs and deliver tailored solutions.</p>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="400">
                    <div class="feature-card card border-0 shadow-sm h-100">
                        <div class="card-body text-center p-4">
                            <div class="feature-icon bg-gradient-primary text-white rounded-circle mb-3 mx-auto">
                                <i class="bi bi-award fs-2"></i>
                            </div>
                            <h4 class="fw-bold mb-3">Excellence</h4>
                            <p class="text-muted">We're committed to delivering the highest quality solutions that exceed expectations.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="row text-center mb-5">
                <div class="col-lg-8 mx-auto">
                    <h2 class="display-5 fw-bold mb-3" data-aos="fade-up">Meet Our Team</h2>
                    <p class="lead text-muted" data-aos="fade-up" data-aos-delay="100">
                        The talented people behind TechFlow's success
                    </p>
                </div>
            </div>
            
            <div class="row g-4">
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="200">
                    <div class="team-card card border-0 shadow-sm h-100">
                        <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?ixlib=rb-4.0.3&auto=format&fit=crop&w=400&q=80" 
                                class="card-img-top" alt="Team Member">
                        <div class="card-body text-center p-4">
                            <h4 class="fw-bold mb-1">John Smith</h4>
                            <p class="text-primary mb-3">CEO & Founder</p>
                            <p class="text-muted mb-4">With over 15 years of experience in technology leadership.</p>
                            <div class="social-links d-flex justify-content-center gap-3">
                                <a href="#" class="text-primary"><i class="bi bi-linkedin"></i></a>
                                <a href="#" class="text-primary"><i class="bi bi-twitter"></i></a>
                                <a href="#" class="text-primary"><i class="bi bi-envelope"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="300">
                    <div class="team-card card border-0 shadow-sm h-100">
                        <img src="https://pulitzercenter.org/sites/default/files/2023-06/Sarah%20Johnson.JPG" 
                                class="card-img-top" alt="Team Member">
                        <div class="card-body text-center p-4">
                            <h4 class="fw-bold mb-1">Sarah Johnson</h4>
                            <p class="text-primary mb-3">CTO</p>
                            <p class="text-muted mb-4">Expert in cloud architecture and software development.</p>
                            <div class="social-links d-flex justify-content-center gap-3">
                                <a href="#" class="text-primary"><i class="bi bi-linkedin"></i></a>
                                <a href="#" class="text-primary"><i class="bi bi-twitter"></i></a>
                                <a href="#" class="text-primary"><i class="bi bi-envelope"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="400">
                    <div class="team-card card border-0 shadow-sm h-100">
                        <img src="data:image/jpeg;base64," 
                                class="card-img-top" alt="Team Member">
                        <div class="card-body text-center p-4">
                            <h4 class="fw-bold mb-1">Mike Davis</h4>
                            <p class="text-primary mb-3">Lead Developer</p>
                            <p class="text-muted mb-4">Specializes in full-stack development and system architecture.</p>
                            <div class="social-links d-flex justify-content-center gap-3">
                                <a href="#" class="text-primary"><i class="bi bi-linkedin"></i></a>
                                <a href="#" class="text-primary"><i class="bi bi-twitter"></i></a>
                                <a href="#" class="text-primary"><i class="bi bi-envelope"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="cta-section py-5">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 mx-auto text-center text-white">
                    <h2 class="display-5 fw-bold mb-3" data-aos="zoom-in">Ready to Work With Us?</h2>
                    <p class="lead mb-4" data-aos="zoom-in" data-aos-delay="100">
                        Let's discuss how we can help transform your business with technology.
                    </p>
                    <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center" data-aos="zoom-in" data-aos-delay="200">
                        <a href="contact.html" class="btn btn-light btn-lg px-5">
                            <i class="bi bi-telephone me-2"></i>Contact Us
                        </a>
                        <a href="index.html#services" class="btn btn-outline-light btn-lg px-5">
                            <i class="bi bi-grid me-2"></i>Our Services
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}